# TrustLedger Environment Variables
# Copy to .env.local and fill in values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ORG=your-org-slug

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# GitHub App
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-random-webhook-secret

# Auth (set true to bypass auth in demo mode)
NEXT_PUBLIC_SKIP_AUTH=false

# Optional: Slack alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Optional: SendGrid
SENDGRID_API_KEY=SG.xxxxx
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Encrypts 2FA secrets at rest (AES-256-GCM). 32 random bytes as 64 hex chars, e.g. `openssl rand -hex 32`.
# Once set, never change or remove it: secrets sealed with it could no longer be read.
DATA_ENCRYPTION_KEY=

# Published contact addresses (hello@, privacy@, sales@, support@, updates@, security@ this domain).
# Unset = the undeliverable placeholder trustledger.example. NEXT_PUBLIC_SECURITY_CONTACT overrides the security address alone.
NEXT_PUBLIC_CONTACT_DOMAIN=
NEXT_PUBLIC_SECURITY_CONTACT=
