    "name": "TrustLedger Hard Python Benchmark",
    "version": "1.0",
    "cases": 60,
    "bonus_cases": 7,
    "purpose": "AST taint and semantic SAST gap analysis",
}

if __name__ == "__main__":
    print(json.dumps(BENCHMARK_METADATA, indent=2))
