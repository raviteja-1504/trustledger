const express = require("express");
const fs = require("fs");
const app = express();
function scheduleWrite(userPath, callback) {
  const captured = userPath;
  setImmediate(() => callback(captured));
}
app.get("/write", (req, res) => {
  scheduleWrite(req.query.path, path => fs.writeFileSync(path, "data"));
  res.send("scheduled");
});
