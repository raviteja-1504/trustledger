/**
 * JuiceShop-pattern benchmark fixture (TypeScript / Node.js)
 * Cases 01–15: vulnerable patterns modelled on OWASP Juice Shop
 * Cases 71–80: negative (safe) patterns — MUST NOT trigger a finding
 * BENCHMARK ONLY — DO NOT DEPLOY.
 */
import express, { Request, Response } from "express";
import * as fs from "node:fs";
import * as path from "node:path";
import * as cp from "node:child_process";
import * as http from "node:http";
import * as crypto from "node:crypto";
import jwt from "jsonwebtoken";

const app  = express();
const db: any = { query: async (q: string, p?: unknown[]) => ({ rows: [] }) };
const BASE = "/srv/juiceshop/uploads";

// ── Vulnerable patterns ───────────────────────────────────────────────────────

// 01
// SQL injection — user id interpolated directly (Juice Shop /users/:id pattern)
app.get("/user/:id", async (req: Request, res: Response) => {
  const id = req.params.id;
  const result = await db.query(`SELECT * FROM users WHERE id = '${id}'`);
  res.json(result.rows);
});

// 02
// SQL injection — login bypass via string concatenation (Juice Shop login)
app.post("/login", async (req: Request, res: Response) => {
  const { email, password } = req.body;
  const rows = await db.query(
    "SELECT * FROM users WHERE email = '" + email + "' AND password = '" + password + "'"
  );
  res.json({ user: rows.rows[0] ?? null });
});

// 03
// XSS — reflected search term in HTML response (Juice Shop /search)
app.get("/search", (req: Request, res: Response) => {
  const q = req.query.q as string ?? "";
  res.type("html").send(`<h1>Results for: ${q}</h1>`);
});

// 04
// XSS — product description unescaped in template (Juice Shop /products/:id)
function renderProduct(name: string, description: string): string {
  return `<div class="product"><h2>${name}</h2><p>${description}</p></div>`;
}
app.get("/product/:id", async (req: Request, res: Response) => {
  const row = (await db.query(`SELECT * FROM products WHERE id = ${req.params.id}`)).rows[0];
  res.type("html").send(renderProduct(row.name, row.description));
});

// 05
// Command injection — Juice Shop image processing via shell
app.post("/admin/convert-image", (req: Request, res: Response) => {
  const filename = req.body.filename as string;
  cp.exec(`convert /srv/images/${filename} /srv/out/thumb.jpg`, (err) => {
    res.json({ ok: !err });
  });
});

// 06
// SSRF — Juice Shop coupon validation calls user-supplied URL
app.post("/coupon/validate", async (req: Request, res: Response) => {
  const url = req.body.couponServer as string;
  const response = await fetch(url);
  const data = await response.json();
  res.json(data);
});

// 07
// Path traversal — Juice Shop file download endpoint
app.get("/ftp/:filename", (req: Request, res: Response) => {
  const file = req.params.filename;
  const filePath = path.join(BASE, file);
  res.sendFile(filePath);
});

// 08
// Prototype pollution — merge from user-controlled JSON (Juice Shop API)
function deepMerge(target: Record<string, unknown>, src: Record<string, unknown>): void {
  for (const key of Object.keys(src)) {
    if (typeof src[key] === "object" && src[key] !== null) {
      (target as any)[key] ??= {};
      deepMerge((target as any)[key], src[key] as Record<string, unknown>);
    } else {
      (target as any)[key] = src[key];
    }
  }
}
app.post("/api/config", (req: Request, res: Response) => {
  const config: Record<string, unknown> = {};
  deepMerge(config, req.body);
  res.json({ ok: true, config });
});

// 09
// ReDoS — email validation regex (Juice Shop registration)
app.post("/register", (req: Request, res: Response) => {
  const { email } = req.body;
  const emailRe = /^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
  res.json({ valid: emailRe.test(email) });
});

// 10
// Auth weakness — JWT none algorithm accepted (Juice Shop JWT flaw)
app.post("/api/token/verify", (req: Request, res: Response) => {
  const token = req.body.token as string;
  const decoded = jwt.verify(token, "", { algorithms: ["none"] as any });
  res.json({ user: decoded });
});

// 11
// Auth weakness — hardcoded admin credentials
const ADMIN_SECRET = "s3cr3t";
app.post("/admin/backdoor", (req: Request, res: Response) => {
  if (req.body.password !== ADMIN_SECRET) return res.status(401).json({ error: "forbidden" });
  res.json({ token: crypto.randomBytes(16).toString("hex") });
});

// 12
// Secrets exposure — API key in source (Juice Shop third-party integration)
const STRIPE_SECRET = "sk_live_abcdef1234567890";
app.post("/payment/charge", async (req: Request, res: Response) => {
  const r = await fetch("https://api.stripe.test/v1/charges", {
    method: "POST",
    headers: { Authorization: `Bearer ${STRIPE_SECRET}` },
    body: JSON.stringify({ amount: req.body.amount }),
  });
  res.json(await r.json());
});

// 13
// SSRF via open redirect to internal service (Juice Shop redirect)
app.get("/redirect", (req: Request, res: Response) => {
  const url = req.query.to as string;
  res.redirect(url);
});

// 14
// XSS — HTML from stored user profile displayed without escaping
app.get("/profile/:uid", async (req: Request, res: Response) => {
  const user = (await db.query(`SELECT bio FROM users WHERE id = ${req.params.uid}`)).rows[0];
  res.type("html").send(`<section class="bio">${user.bio}</section>`);
});

// 15
// Path traversal via double-decode (Juice Shop path decode bypass)
app.get("/download", (req: Request, res: Response) => {
  const name = decodeURIComponent(decodeURIComponent(req.query.file as string));
  res.sendFile(path.join(BASE, name));
});

// ── Negative (safe) patterns ──────────────────────────────────────────────────
// These MUST NOT produce any scanner finding in the expected category.

// 71
// SAFE SQL — parameterised query (Juice Shop should use this everywhere)
app.get("/safe/user/:id", async (req: Request, res: Response) => {
  const id = Number(req.params.id);
  const result = await db.query("SELECT * FROM users WHERE id = $1", [id]);
  res.json(result.rows);
});

// 72
// SAFE XSS — HTML-escaped output via a sanitisation helper
function escapeHtml(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
}
app.get("/safe/search", (req: Request, res: Response) => {
  const q = escapeHtml(req.query.q as string ?? "");
  res.type("html").send(`<h1>Results for: ${q}</h1>`);
});

// 73
// SAFE command — execFile with an argument array (no shell interpolation)
app.post("/safe/convert", (req: Request, res: Response) => {
  const name = path.basename(req.body.filename as string);
  cp.execFile("convert", [`/srv/images/${name}`, "/srv/out/thumb.jpg"], (err) => {
    res.json({ ok: !err });
  });
});

// 74
// SAFE SSRF — URL allowlisted before fetch
const ALLOWED_COUPON_HOSTS = new Set(["coupons.example.com"]);
app.post("/safe/coupon", async (req: Request, res: Response) => {
  const url = new URL(req.body.couponServer as string);
  if (!ALLOWED_COUPON_HOSTS.has(url.hostname)) return res.status(403).json({ error: "disallowed" });
  const response = await fetch(url.toString());
  res.json(await response.json());
});

// 75
// SAFE path traversal — basename stripping + allow-listed directory
app.get("/safe/ftp/:filename", (req: Request, res: Response) => {
  const name = path.basename(req.params.filename);
  res.sendFile(path.join(BASE, name));
});

// 76
// SAFE JWT — explicit HS256, no none algorithm accepted
app.post("/safe/token/verify", (req: Request, res: Response) => {
  try {
    const decoded = jwt.verify(req.body.token, process.env.JWT_SECRET ?? "changeme",
                               { algorithms: ["HS256"] });
    res.json({ user: decoded });
  } catch {
    res.status(401).json({ error: "invalid_token" });
  }
});

// 77
// SAFE secrets — API key from environment variable, not hardcoded
app.post("/safe/payment", async (req: Request, res: Response) => {
  const key = process.env.STRIPE_SECRET_KEY ?? "";
  const r = await fetch("https://api.stripe.test/v1/charges", {
    method: "POST",
    headers: { Authorization: `Bearer ${key}` },
    body: JSON.stringify({ amount: req.body.amount }),
  });
  res.json(await r.json());
});

// 78
// SAFE redirect — validation against an allow-list
const ALLOWED_REDIRECTS = ["https://example.com", "https://shop.example.com"];
app.get("/safe/redirect", (req: Request, res: Response) => {
  const url = req.query.to as string;
  if (!ALLOWED_REDIRECTS.includes(url)) return res.status(400).json({ error: "not_allowed" });
  res.redirect(url);
});

export default app;
