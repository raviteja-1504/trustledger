# VulnBench-pattern benchmark fixture (Python / Flask)
# Cases 01-12: vulnerable patterns modelled on VulnBench
# Cases 71-77: negative (safe) patterns — MUST NOT trigger a finding
# BENCHMARK ONLY — DO NOT DEPLOY.

from flask import Flask, request, jsonify, Response
import sqlite3
import subprocess
import requests
import jinja2
import os
import hashlib
import jwt

app = Flask(__name__)
DB = "vulnbench.db"

# -- Vulnerable patterns -------------------------------------------------------

# 01
# SQL injection — raw string formatting in SQLite query (VulnBench /users)
@app.route("/users")
def get_user():
    uid = request.args.get("id", "")
    conn = sqlite3.connect(DB)
    cur = conn.cursor()
    cur.execute("SELECT * FROM users WHERE id = '%s'" % uid)
    return jsonify(cur.fetchall())

# 02
# SQL injection — f-string interpolation in ORDER BY (VulnBench /sort)
@app.route("/sort")
def sorted_items():
    col = request.args.get("col", "name")
    conn = sqlite3.connect(DB)
    cur = conn.cursor()
    cur.execute(f"SELECT * FROM items ORDER BY {col}")
    return jsonify(cur.fetchall())

# 03
# SSRF — user-supplied URL passed directly to requests.get (VulnBench /fetch)
@app.route("/fetch")
def fetch_url():
    url = request.args.get("url")
    resp = requests.get(url)
    return resp.text, 200

# 04
# SSRF — async user-supplied URL forwarded to internal microservice
@app.route("/proxy")
def proxy():
    target = request.args.get("service")
    resp = requests.get(target, timeout=5)
    return jsonify(resp.json())

# 05
# Template injection — user input rendered via Jinja2.from_string (VulnBench /greet)
@app.route("/greet")
def greet():
    name = request.args.get("name", "world")
    template = jinja2.Environment(loader=jinja2.BaseLoader()).from_string(
        "Hello, " + name + "!"
    )
    return template.render()

# 06
# Command injection — shell=True with unsanitised input (VulnBench /ping)
@app.route("/ping")
def ping():
    host = request.args.get("host", "127.0.0.1")
    result = subprocess.run(f"ping -c1 {host}", shell=True, capture_output=True, text=True)
    return result.stdout

# 07
# Path traversal — open() with user-supplied path (VulnBench /file)
@app.route("/file")
def read_file():
    name = request.args.get("name")
    with open(os.path.join("/srv/files", name)) as f:
        return f.read()

# 08
# Auth weakness — MD5 for password storage (VulnBench /register)
@app.route("/register", methods=["POST"])
def register():
    data = request.json
    pw_hash = hashlib.md5(data["password"].encode()).hexdigest()
    conn = sqlite3.connect(DB)
    conn.execute("INSERT INTO users(email, pw) VALUES (?, ?)", (data["email"], pw_hash))
    conn.commit()
    return jsonify({"ok": True})

# 09
# Auth weakness — JWT none algorithm accepted (VulnBench token check)
@app.route("/token/verify", methods=["POST"])
def verify_token():
    token = request.json.get("token")
    decoded = jwt.decode(token, options={"verify_signature": False})
    return jsonify(decoded)

# 10
# Secrets exposure — hardcoded API key (VulnBench payment integration)
AWS_SECRET = "AKIA1234567890ABCDEF"
@app.route("/reports/export")
def export_report():
    # Sends report to S3 using hardcoded credentials
    return jsonify({"key": AWS_SECRET, "bucket": "vulnbench-reports"})

# 11
# XSS — template rendered from user input without auto-escape (VulnBench /comment)
@app.route("/comment")
def comment():
    text = request.args.get("text", "")
    env = jinja2.Environment(autoescape=False)
    return env.from_string("<p>Comment: {{ text }}</p>").render(text=text)

# 12
# eval() — dynamic code execution from user input (VulnBench /calc)
@app.route("/calc")
def calc():
    expression = request.args.get("expr", "1+1")
    result = eval(expression)
    return jsonify({"result": result})

# -- Negative (safe) patterns --------------------------------------------------
# These MUST NOT produce any scanner finding in the expected category.

# 71
# SAFE SQL — parameterised placeholder (?)
@app.route("/safe/users")
def safe_get_user():
    uid = request.args.get("id", "")
    conn = sqlite3.connect(DB)
    cur = conn.cursor()
    cur.execute("SELECT * FROM users WHERE id = ?", (uid,))
    return jsonify(cur.fetchall())

# 72
# SAFE SSRF — URL validated against an allowlist before request
ALLOWED_HOSTS = {"api.example.com", "cdn.example.com"}
@app.route("/safe/fetch")
def safe_fetch():
    from urllib.parse import urlparse
    url = request.args.get("url")
    if urlparse(url).hostname not in ALLOWED_HOSTS:
        return jsonify({"error": "disallowed"}), 403
    return requests.get(url).text

# 73
# SAFE template — autoescape=True (Jinja2 default security)
@app.route("/safe/greet")
def safe_greet():
    name = request.args.get("name", "world")
    env = jinja2.Environment(autoescape=True)
    return env.from_string("<h1>Hello, {{ name }}!</h1>").render(name=name)

# 74
# SAFE command — subprocess with argument list, no shell=True
@app.route("/safe/ping")
def safe_ping():
    host = request.args.get("host", "127.0.0.1")
    result = subprocess.run(["ping", "-c1", host], capture_output=True, text=True)
    return result.stdout

# 75
# SAFE path — os.path.basename to strip traversal sequences
@app.route("/safe/file")
def safe_read_file():
    name = os.path.basename(request.args.get("name", ""))
    with open(os.path.join("/srv/files", name)) as f:
        return f.read()

# 76
# SAFE auth — bcrypt for password hashing
@app.route("/safe/register", methods=["POST"])
def safe_register():
    import bcrypt
    data = request.json
    pw_hash = bcrypt.hashpw(data["password"].encode(), bcrypt.gensalt()).decode()
    conn = sqlite3.connect(DB)
    conn.execute("INSERT INTO users(email, pw) VALUES (?, ?)", (data["email"], pw_hash))
    conn.commit()
    return jsonify({"ok": True})

# 77
# SAFE secrets — AWS key from environment
@app.route("/safe/reports/export")
def safe_export():
    key = os.environ.get("AWS_SECRET_ACCESS_KEY", "")
    return jsonify({"bucket": "reports"})
